# 1. Valutazioni mensili con propagazione causale in avanti (max 15 mesi)
val_m = vals_sub.groupby(["player_id", "year_month"])["market_value_in_eur"].last().unstack(0)
val_ff = val_m.reindex(val_grid).ffill(limit=15)

# 2. Club storico: evento piu' recente tra presenze (12m, no Nazionali) e trasferimenti (36m, 30/6->1/7)
use_tr = (td >= ad) & (td > 0)
use_app = (ad > td) & (ad > 0)
club_hist = pd.DataFrame(np.where(use_tr, tc, np.where(use_app, ac, np.nan)),
                         index=target_months, columns=val_ff.columns)

# 3. Mappa (stagione, club_id) -> campionato Top-5 da games.csv (con override fattuale 2020-07 -> 2019)
rose = long_club.merge(long_val, on=["year_month", "player_id"], how="inner")
rose["season"] = stagione_da_mese(rose["year_month"], override_stagione)
rose = rose.merge(mappa_club_stagione, on=["season", "club_id"], how="left")
rose = rose[rose["league"].isin(TOP5_CODES)]
